PORT=3000
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE

# Required in production — the server refuses to start without it.
JWT_SECRET=replace-with-a-long-random-secret

# TMDB. Server-side only — never ships to the browser.
API_READ_ACCESS=your-tmdb-read-access-token
API_KEY=your-tmdb-api-key

# Comma-separated. Unset = reflect any origin (dev only).
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
